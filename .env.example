# ==========================================================================
# soc-automation-playbooks — configuration reference
# ==========================================================================
#
# IMPORTANT: nothing reads this file automatically.
#
# The n8n workflow ships with literal placeholder strings in node parameters,
# not $env expressions, because n8n blocks environment access inside nodes by
# default (N8N_BLOCK_ENV_ACCESS_IN_NODE=true). This file is a worksheet: fill
# it in, then paste the values into the n8n UI, and keep it as your record of
# what you configured.
#
# Copy to .env (git-ignored) and fill in. Never commit the result.
# See workflows/n8n/ai-soc-assistant/configuration.md for exact node locations.
# ==========================================================================

# --------------------------------------------------------------------------
# n8n
# --------------------------------------------------------------------------
# Base URL of your n8n instance. Used to construct the webhook URL.
N8N_BASE_URL=https://n8n.example.com

# Webhook path on the "Webhook" node. Ships as "ai-soc-assistant".
# CHANGE THIS. The webhook is unauthenticated, so the path is currently the
# only access control. Generate an unguessable one:
#   python3 -c "import secrets; print('soc-' + secrets.token_hex(16))"
WAZUH_WEBHOOK_PATH=ai-soc-assistant

# --------------------------------------------------------------------------
# Ollama  (REQUIRED — node: "LLM (ollama)")
# --------------------------------------------------------------------------
# Must be reachable FROM n8n. Inside a container, "localhost" is the container.
# Docker Compose:      http://ollama:11434
# n8n in Docker, host: http://host.docker.internal:11434  (macOS/Windows)
#
# SECURITY: pointing this at a hosted inference API sends security telemetry —
# internal hostnames, usernames, addressing, live incident detail — to a third
# party. That is a data protection decision, not a configuration tweak.
OLLAMA_BASE_URL=http://ollama.example.com:11434

# Model name, set in the JSON body of the "LLM (ollama)" node.
# Ships as qwen3:14b, which is what the workflow was built and tested against.
# Must be pulled on the Ollama host: ollama pull qwen3:14b
# Context window must exceed the largest prompt (~31 KB) plus the event.
OLLAMA_MODEL=qwen3:14b

# --------------------------------------------------------------------------
# Slack  (REQUIRED)
# --------------------------------------------------------------------------
# Bot User OAuth Token. Goes in the n8n Slack API credential, NOT in a node.
# Scopes: chat:write, channels:history (+ groups:history for private channels).
SLACK_BOT_TOKEN=xoxb-REPLACE-ME

# Slack app signing secret.
# NOT USED BY THE WORKFLOW — this workflow does not verify request signatures.
# Configure it on the reverse proxy that should sit in front of n8n.
# See docs/security-model.md.
SLACK_SIGNING_SECRET=REPLACE-ME

# Your bot's member ID (starts with U). Used by the loop guard in the
# "Classifier" node. Without it the bot can end up answering itself.
#   curl -s -H "Authorization: Bearer $SLACK_BOT_TOKEN" \
#        https://slack.com/api/auth.test
SLACK_BOT_USER_ID=REPLACE-ME

# Channel ID. NOT CONFIGURED in this workflow — the Slack node resolves the
# channel from the inbound event, so the assistant replies wherever it is
# addressed. Set this only if you modify the node to pin one channel.
SLACK_CHANNEL_ID=

# ==========================================================================
# PLANNED INTEGRATIONS — none of the values below are used by any workflow
# in this repository. They are listed so the intended end state is visible in
# one place. See docs/roadmap.md.
# ==========================================================================

# Threat intelligence enrichment — PLANNED (roadmap item 4)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Case management and analyzers — PLANNED (roadmap items 8, 9)
THEHIVE_URL=
CORTEX_URL=

# Threat intelligence correlation — PLANNED (roadmap item 10)
OPENCTI_URL=
